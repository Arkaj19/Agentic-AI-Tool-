# Copy to .env and fill in. Never commit the real .env.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_HOSTNAME=
SP_SITE_PATH=
# Folder the Rulebook's Fetch button opens
SP_MAPPINGS_FOLDER=Mappings
# Databricks S/4 output used for validation
SP_DATABRICKS_FOLDER=Databricks Files
SP_DATABRICKS_FILE=S_MARC#FreeText - {plant}.csv

# sharepoint | local (local reads ../local_sharepoint, laid out like the library)
SOURCE_MODE=sharepoint
LOCAL_SOURCE_ROOT=

# azure | none (none = read the rules without the model)
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=16000

# Validation (demo: one plant against the Databricks output)
VALIDATION_PLANT=1021
MATCH_PASS_MARK=0.95
FIELD_PASS_MARK=0.99

FRONTEND_ORIGIN=http://localhost:5180

# Databricks pipeline
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_NOTEBOOK_ROOT=
DATABRICKS_VOLUME_PATH=/Volumes/dbr_agent/silver/sap
DBX_SILVER_TABLE=dbr_agent.silver.marc_dap
DBX_GOLD_TABLE=dbr_agent.gold.marc_dap
# rule book shown from SharePoint (text) and used locally for code generation
SP_DBX_RULEBOOK_PATH=Mappings/Databricks/MARC_Rule_Book_dbr_agent.txt
DBX_RULEBOOK_LOCAL=
DBX_ROW_RULES=
DBX_MAX_FIX_ATTEMPTS=3
DBX_MAX_RUN_ATTEMPTS=2
